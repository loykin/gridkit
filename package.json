{
  "name": "@loykin/gridkit",
  "version": "0.0.0-dev",
  "description": "A feature-rich React DataGrid component with virtualization, sorting, filtering, and pagination.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles": {
      "types": "./dist/styles.d.ts",
      "default": "./dist/styles.css"
    },
    "./adapters/shadcn": {
      "types": "./dist/adapters/shadcn.d.ts",
      "import": "./dist/adapters/shadcn.js",
      "require": "./dist/adapters/shadcn.cjs"
    },
    "./adapters/mui": {
      "types": "./dist/adapters/mui.d.ts",
      "import": "./dist/adapters/mui.js",
      "require": "./dist/adapters/mui.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --noEmit && eslint src --ext .ts,.tsx && tsup && node scripts/build-css.mjs && echo 'declare const styles: string; export default styles;' > dist/styles.d.ts",
    "build:js": "tsup",
    "build:css": "node scripts/build-css.mjs",
    "dev": "concurrently \"tsup --watch\" \"pnpm --filter data-grid-playground dev\"",
    "type-check": "tsc --noEmit",
    "lint": "eslint src e2e --ext .ts,.tsx,.mjs",
    "lint:fix": "eslint src e2e --ext .ts,.tsx,.mjs --fix",
    "test": "vitest run",
    "test:consumer": "node scripts/verify-package-consumer.mjs",
    "test:e2e": "node --test e2e/*.test.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "clsx": "^2.1.1",
    "lucide-react": "^1.70.0",
    "zustand": "^5.1.0"
  },
  "peerDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/material": "^7.0.0 || ^8.0.0 || ^9.0.0",
    "@tanstack/react-table": "^9.1.2",
    "@tanstack/react-virtual": "^3.13.24",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@emotion/react": {
      "optional": true
    },
    "@emotion/styled": {
      "optional": true
    },
    "@mui/material": {
      "optional": true
    }
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@eslint/js": "^10.0.1",
    "@mui/material": "^9.5.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^31.0.0",
    "playwright": "^1.65.0",
    "prettier": "^3.9.10",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "keywords": [
    "react",
    "datagrid",
    "table",
    "virtualization",
    "tanstack"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/loykin/gridkit.git"
  },
  "homepage": "https://loykin.github.io/gridkit/",
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
