{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@loykin/gridkit": ["../src/index.ts"],
      "@loykin/gridkit/adapters/shadcn": ["../src/adapters/shadcn.tsx"],
      "@loykin/gridkit/adapters/mui": ["../src/adapters/mui.tsx"],
      "@/*": ["../src/*"]
    }
  },
  "include": ["src"]
}
